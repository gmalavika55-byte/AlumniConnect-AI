# ==============================================================================
# AlumniConnect AI - Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (do NOT commit your real '.env' file to Git):
#    cp .env.example .env
# 2. Replace the CHANGE_ME placeholders with your actual deployment credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ORACLE DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
ORACLE_PASSWORD=CHANGE_ME_ORACLE_PASSWORD
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@oracle-db:1521/xe
SPRING_DATASOURCE_USERNAME=system
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_ORACLE_PASSWORD

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT CONFIGURATION
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret key for HMAC-SHA256 JWT signatures
JWT_SECRET=CHANGE_ME_JWT_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# ------------------------------------------------------------------------------
# 3. FRONTEND BUILD VARIABLES (Exposed to browser via Vite)
# ------------------------------------------------------------------------------
# For local Docker testing: http://localhost:8080
# For cloud domain: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8080
VITE_AI_SERVICE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=CHANGE_ME_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_KEY_SECRET

# ------------------------------------------------------------------------------
# 5. 8x8 JaaS (VIDEO MENTORSHIP) CONFIGURATION
# ------------------------------------------------------------------------------
JAAS_APP_ID=CHANGE_ME_JAAS_APP_ID
JAAS_KEY_ID=CHANGE_ME_JAAS_KEY_ID
JAAS_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 6. SMTP EMAIL NOTIFICATIONS & PASSWORD RESET OTP (BREVO / GMAIL)
# ------------------------------------------------------------------------------
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
BREVO_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
BREVO_SMTP_FROM=noreply@alumniconnect.com
